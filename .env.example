# Create a Telegram bot through BotFather. Keep this file private after filling it.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to use the private bot.
ALLOWED_TELEGRAM_CHAT_IDS=
AI_ROUTER_API_KEY=
AI_BASE_URL=https://api.imarouter.com/v1
AI_CHEAP_MODEL=gpt-5.2
AI_CREATIVE_MODEL=gpt-5.5
OPENAI_MONTHLY_LIMIT_USD=10
REELBOT_DATA_DIR=/data
# Optional until a verified Higgsfield MCP quote/operation is available.
HIGGSFIELD_MONTHLY_CREDIT_LIMIT=0
# Optional HTTPS reverse proxy URL for large-file upload.
PUBLIC_BASE_URL=
# Generate a long random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
UPLOAD_SECRET=
# Optional private Telegram chat for exception notifications.
OPERATOR_CHAT_ID=
# Optional JSON file mounted on the host with approved brand facts and style.
BRAND_PROFILE_PATH=/data/brand_profile.json

